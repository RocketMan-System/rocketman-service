#!/bin/sh
# Rebuilds the graphify knowledge graph and stages graphify-out/ so the graph
# lands in the same commit as the code it describes.
# Installed by scripts/install-git-hooks.sh. Skip once with GRAPHIFY_SKIP_HOOK=1.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0

# Nothing to do when only graph artifacts are staged.
STAGED=$(git diff --cached --name-only)
NON_GRAPH=$(printf '%s\n' "$STAGED" | grep -v '^graphify-out/' | grep -v '^$' || true)
[ -z "$NON_GRAPH" ] && exit 0

if ! command -v graphify >/dev/null 2>&1; then
    echo "[graphify pre-commit] graphify not found on PATH, graph not updated" >&2
    exit 0
fi

# Same seed as graphify's own hooks: keeps community clustering reproducible.
export PYTHONHASHSEED=0

if ! graphify update . --force >/dev/null 2>&1; then
    echo "[graphify pre-commit] 'graphify update .' failed; fix it or commit with GRAPHIFY_SKIP_HOOK=1" >&2
    exit 1
fi

git add graphify-out/
